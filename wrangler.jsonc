{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omx-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "assets": { "directory": "./public", "run_worker_first": false },
  "routes": [
    { "pattern": "lab.omxhub.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
